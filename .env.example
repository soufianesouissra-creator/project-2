# ─────────────────────────────────────────────────────────────────────────────
# TRANSPOLEQ — variables d'environnement
# Copier vers .env.local. Aucun secret n'est versionné.
# ─────────────────────────────────────────────────────────────────────────────

# URL canonique du site. Sert aux metadata, au sitemap et aux images OG.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── E-mail (Phase 1) ─────────────────────────────────────────────────────────
# Resend. Repli possible : SMTP Microsoft 365 via nodemailer.
RESEND_API_KEY=""
MAIL_FROM="site@transpoleq.ma"
MAIL_TO_DISPATCH="dispatch@transpoleq.ma"
MAIL_TO_RH="rh@transpoleq.ma"

# ── Anti-spam (Phase 1) ──────────────────────────────────────────────────────
# Cloudflare Turnstile. Sans ces clés, les formulaires passent en mode test.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Dépôt de CV (Phase 2) ────────────────────────────────────────────────────
# Vercel Blob. Le lien du fichier est joint à l'e-mail RH.
BLOB_READ_WRITE_TOKEN=""

# ── Mesure d'audience (Phase 3) ──────────────────────────────────────────────
# Chargée uniquement après consentement. Vide = aucune mesure.
NEXT_PUBLIC_ANALYTICS=""
