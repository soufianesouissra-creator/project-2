# --- Phase 1: no runtime secrets are used yet. ---
# Every variable below is documented ahead of the phase that consumes it.

# Show /styleguide outside development (it is always visible in `next dev`)
# SHOW_STYLEGUIDE=1

# --- Phase 4: quote form email via Microsoft Graph (aleq.ma tenant) ---
# App registration with Mail.Send application permission, scoped by an
# ApplicationAccessPolicy to the shared mailbox below.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# QUOTE_MAILBOX=devis@aleq.ma

# Fallback email provider
# RESEND_API_KEY=

# Anti-spam
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Attachments
# BLOB_READ_WRITE_TOKEN=
