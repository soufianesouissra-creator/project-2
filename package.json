{
  "name": "transpoleq-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm typecheck && pnpm lint && pnpm gen:content-todo",
    "test:e2e": "playwright test",
    "shots": "node scripts/screenshots.mjs",
    "gen:content-todo": "node --experimental-strip-types --no-warnings scripts/gen-content-todo.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "next": "15.5.23",
    "next-intl": "^4.13.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.23",
    "playwright": "^1.49.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
